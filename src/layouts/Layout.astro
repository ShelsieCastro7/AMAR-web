---
import '../styles/global.css';
import '@fontsource/barrio';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AMAR — Amor en Movimiento, Acción y Resistencia' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | AMAR</title>
    
    <!-- Fuentes de Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/images/amar-logo.png" />
  </head>
  <body class="bg-amar-beige text-amar-negro font-cuerpo antialiased">
    <slot />
  </body>
</html>